# Banco de dados (Supabase)
# Use a connection string do pooler (porta 6543) ou conexão direta (5432)
DATABASE_URL=
DATABASE_SSL=true

# Better Auth
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=troque-por-uma-string-aleatoria-com-32-caracteres

# Supabase Storage (upload de logos e arquivos)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_BUCKET=apps

# Admin criado pelo seed (`npm run db:seed`)
ADMIN_EMAIL=admin@playdownload.com
ADMIN_PASSWORD=admin12345
ADMIN_NAME=Administrador
